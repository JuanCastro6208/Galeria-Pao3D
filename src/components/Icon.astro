---
import { iconos, type IconName } from '../lib/iconos';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Texto para lectores de pantalla. Sin él, el ícono es decorativo. */
  label?: string;
}

const { name, size = '1.25em', class: className, label } = Astro.props;
const Svg = iconos[name];
---

<Svg
  width={size}
  height={size}
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
/>
