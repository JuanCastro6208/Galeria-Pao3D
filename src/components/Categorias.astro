---
import { Picture } from 'astro:assets';
import { categorias } from '../data/categorias';
import { imagenDeFigura } from '../lib/imagenes';
import Icon from './Icon.astro';

const tarjetas = categorias.map((c) => ({
  ...c,
  foto: 'portada' in c ? imagenDeFigura(c.portada) : undefined,
}));
---

<section class="section" id="categorias" aria-labelledby="categorias-titulo">
  <div class="container">
    <header class="head" data-reveal>
      <h2 class="section-title" id="categorias-titulo">Lo que imprimimos</h2>
      <p class="lead">Si se puede modelar, se puede imprimir. Estas son nuestras especialidades.</p>
    </header>

    <ul class="bento">
      {
        tarjetas.map((c, i) => (
          <li class:list={['cell', `cell--${c.id}`, { 'cell--foto': c.foto }]} data-reveal style={`--i:${i}`}>
            <a class="cell__core" href="#galeria" data-ir-filtro={c.id}>
              <div class="cell__info">
                {!c.foto && (
                  <span class="cell__icon">
                    <Icon name={c.icono} size="1.6rem" />
                  </span>
                )}
                <div class="cell__body">
                  <h3 class="cell__title">{c.nombre}</h3>
                  <p class="cell__text">{c.descripcion}</p>
                </div>
                <span class="cell__more">
                  Ver trabajos
                  <Icon name="arrow-up-right" size="1rem" />
                </span>
              </div>
              {c.foto ? (
                <span class="cell__foto">
                  <Picture
                    src={c.foto}
                    alt=""
                    formats={['avif', 'webp']}
                    widths={[400, 640, 900]}
                    sizes="(max-width: 960px) 92vw, 40vw"
                  />
                </span>
              ) : (
                <span class="cell__bg" aria-hidden="true">
                  <Icon name={c.icono} size="100%" />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Bento asimétrico: 1 alta + 1 ancha + 2 pequeñas */
  .bento {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(15.5rem, auto));
    gap: 1rem;
  }

  .cell--personalizadas {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .cell--personajes {
    grid-column: 2 / span 2;
    grid-row: 1;
  }

  .cell {
    padding: var(--shell-pad);
    border-radius: calc(var(--r-lg) + var(--shell-pad));
    border: var(--bw) solid var(--line);
    background: var(--shell-bg);
  }

  .cell__core {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.6s var(--ease-spring),
      box-shadow 0.6s var(--ease-spring),
      background-color 0.4s var(--ease-out);
  }

  .cell__info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  /* Foto de la categoría (solo en las tarjetas grandes) */
  .cell__foto {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--r-md);
    border: var(--bw) solid var(--line);
    min-height: 12rem;
  }

  .cell__foto :global(picture),
  .cell__foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cell__foto :global(img) {
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }

  .cell__core:hover .cell__foto :global(img) {
    transform: scale(1.04);
  }

  /* Alta: foto arriba, texto abajo */
  .cell--personalizadas .cell__foto {
    order: -1;
    flex: 1 1 14rem;
  }

  .cell--personalizadas .cell__info {
    flex: none;
  }

  /* Ancha: texto a la izquierda, foto a la derecha */
  .cell--personajes.cell--foto .cell__core {
    flex-direction: row;
    align-items: stretch;
  }

  .cell--personajes .cell__foto {
    flex: 0 0 50%;
  }

  .cell__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--accent-soft);
    color: var(--accent);
    border: var(--bw) solid var(--line);
  }

  .cell__body {
    display: grid;
    gap: 0.6rem;
    margin-top: auto;
    max-width: 34ch;
  }

  .cell__title {
    font-size: var(--fs-h3);
  }

  .cell__text {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .cell__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .cell__more :global(.icon) {
    transition: transform 0.5s var(--ease-spring);
  }

  .cell__core:hover .cell__more :global(.icon) {
    transform: translate(3px, -3px);
  }

  .cell__bg {
    position: absolute;
    z-index: -1;
    right: -8%;
    top: -6%;
    width: 46%;
    aspect-ratio: 1;
    color: var(--text);
    opacity: 0.04;
    transition: transform 0.9s var(--ease-spring);
  }

  .cell__core:hover .cell__bg {
    transform: rotate(-8deg) scale(1.06);
  }

  /* Variaciones de fondo en el tema tecnológico */
  .cell--personalizadas .cell__core {
    background:
      radial-gradient(120% 70% at 0% 100%, rgb(var(--accent-rgb) / 0.16), transparent 60%),
      var(--surface);
  }

  .cell--personalizadas .cell__bg {
    width: 70%;
    top: 4%;
  }

  .cell--personajes .cell__core {
    background:
      radial-gradient(var(--dot) 1.2px, transparent 1.6px) 0 0 / 16px 16px,
      var(--surface);
  }

  /* Líneas horizontales: la textura de las capas impresas */
  .cell--utiles .cell__core {
    background:
      repeating-linear-gradient(to bottom, transparent 0 7px, rgb(255 226 234 / 0.035) 7px 8px),
      var(--surface);
  }

  .cell__core:hover {
    transform: translateY(-4px);
  }

  /* Tema juguetón: cada categoría con su color y sombra de pegatina */
  :global([data-theme='play']) .cell {
    border: 0;
  }

  :global([data-theme='play']) .cell .cell__core {
    border: var(--bw) solid var(--line);
    background: var(--tone, var(--surface));
    color: var(--tone-ink);
  }

  :global([data-theme='play']) .cell--personalizadas {
    --tone: var(--tone-personalizadas);
  }
  :global([data-theme='play']) .cell--personajes {
    --tone: var(--tone-personajes);
  }
  :global([data-theme='play']) .cell--decoracion {
    --tone: var(--tone-decoracion);
  }
  :global([data-theme='play']) .cell--utiles {
    --tone: var(--tone-utiles);
  }

  :global([data-theme='play']) .cell__icon {
    background: var(--surface);
    color: var(--tone-ink);
  }

  :global([data-theme='play']) .cell__text {
    color: var(--tone-ink);
  }

  :global([data-theme='play']) .cell__more {
    color: var(--tone-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  :global([data-theme='play']) .cell__bg {
    opacity: 0.14;
    color: var(--tone-ink);
  }

  :global([data-theme='play']) .cell__core:hover {
    transform: translate(-3px, -3px) rotate(-1deg);
    box-shadow: 9px 9px 0 var(--line);
  }

  :global([data-theme='play']) .cell:nth-child(even) .cell__core:hover {
    transform: translate(-3px, -3px) rotate(1deg);
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    .cell--personalizadas,
    .cell--personajes {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .cell--personalizadas .cell__core {
      min-height: 20rem;
    }

    .cell--personalizadas .cell__bg {
      width: 42%;
      top: -4%;
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .cell--personajes.cell--foto .cell__core {
      flex-direction: column;
    }

    .cell--personajes .cell__foto {
      order: -1;
      flex: none;
    }

    .cell__foto {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .cell__core {
      min-height: 15rem;
    }
  }
</style>
