---
// Franja animada con los servicios y técnicas de la marca.
import Sparkle from '@phosphor-icons/core/fill/sparkle-fill.svg';
import { sitio } from '../config/sitio';
---

<div class="franja-zona">
  <section class="franja" aria-label="Servicios">
    <div class="franja__pista">
      {
        [0, 1].map((copia) => (
          <ul class="franja__lista" aria-hidden={copia === 1 ? 'true' : undefined}>
            {sitio.servicios.map((servicio) => (
              <li>
                <span>{servicio}</span>
                <Sparkle width="0.9em" height="0.9em" class="franja__chispa" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>
</div>

<style>
  /* Recorta las puntas de la franja inclinada para que no haya scroll lateral */
  .franja-zona {
    overflow: hidden;
  }

  :global([data-theme='play']) .franja-zona {
    padding-block: 1.25rem;
  }

  .franja {
    overflow: hidden;
    padding-block: 1.1rem;
    border-block: var(--bw) solid var(--line);
    background: rgb(var(--bg-rgb) / 0.6);
  }

  :global([data-theme='play']) .franja {
    margin-inline: -1rem;
    background: var(--c-amarillo);
    border-color: var(--line);
    transform: rotate(-1.5deg);
  }

  .franja__pista {
    display: flex;
    width: max-content;
    animation: desplazar 40s linear infinite;
  }

  .franja:hover .franja__pista {
    animation-play-state: paused;
  }

  .franja__lista {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    padding: 0;
  }

  .franja__lista li {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.6rem);
    letter-spacing: -0.02em;
  }

  :global(.franja__chispa) {
    color: var(--accent);
  }

  :global([data-theme='play']) .franja__lista li {
    color: var(--tone-ink);
  }

  :global([data-theme='play']) :global(.franja__chispa) {
    color: var(--c-rosa);
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .franja__pista {
      animation: none;
    }
  }
</style>
